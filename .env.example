DB_USER=postgres
DB_PASSWORD=changeme
JWT_SECRET=replace-with-a-generated-base64-secret
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=filevault
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
MONITORING_PASSWORD=
ACTUATOR_EXPOSE=health,info
RECORD_REQUESTS=false
SQL_LOG_LEVEL=INFO

# Frontend origins allowed by the API's CORS (comma-separated, scheme+host[+port], no path). Production:
# CORS_ORIGINS=https://filevault-client.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
